{
  "updatedAt": "2026-03-18T07:45:33.498Z",
  "createdAt": "2026-03-18T07:45:33.498Z",
  "id": "wez9b95FkFe5Wksi",
  "name": "PG → Sheets Sync (5min)",
  "description": null,
  "active": false,
  "isArchived": false,
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "Every 5 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "tables",
              "name": "tables",
              "value": "=[\"members\",\"fees\",\"groups\",\"events\",\"workflow_logs\",\"links\",\"link_clicks\",\"tracks\",\"statuses\",\"payment_statuses\"]",
              "type": "array"
            }
          ]
        }
      },
      "id": "set-tables",
      "name": "Set Table List",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "options": {}
      },
      "id": "split-batches",
      "name": "Loop Over Tables",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const tables = $input.first().json.tables;\nconst currentIndex = $input.first().json.$index || 0;\nreturn [{ json: { tableName: tables[currentIndex], tables: tables, $index: currentIndex } }];"
      },
      "id": "get-current-table",
      "name": "Get Current Table",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "url": "=http://api:8000/v1/internal/dump/{{ $json.tableName }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Sync-Token",
              "value": "={{ $env.SYNC_TOKEN }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "fullResponse": false
            }
          }
        }
      },
      "id": "http-dump",
      "name": "GET /dump/{table}",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Transform API response to Google Sheets format\nconst items = $input.all().map(item => item.json);\nif (items.length === 0) return [];\n\nreturn items.map(row => ({ json: row }));"
      },
      "id": "transform-for-sheets",
      "name": "Transform Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        0
      ]
    },
    {
      "parameters": {
        "operation": "clear",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $env.GOOGLE_SHEETS_ID }}"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "={{ $('Get Current Table').item.json.tableName }}"
        }
      },
      "id": "sheets-clear",
      "name": "Clear Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        1320,
        0
      ]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $env.GOOGLE_SHEETS_ID }}"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "={{ $('Get Current Table').item.json.tableName }}"
        },
        "options": {}
      },
      "id": "sheets-append",
      "name": "Write to Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        1540,
        0
      ]
    }
  ],
  "connections": {
    "Every 5 Minutes": {
      "main": [
        [
          {
            "node": "Set Table List",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Set Table List": {
      "main": [
        [
          {
            "node": "Loop Over Tables",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Loop Over Tables": {
      "main": [
        [],
        [
          {
            "node": "Get Current Table",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Current Table": {
      "main": [
        [
          {
            "node": "GET /dump/{table}",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "GET /dump/{table}": {
      "main": [
        [
          {
            "node": "Transform Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Transform Data": {
      "main": [
        [
          {
            "node": "Clear Sheet",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Clear Sheet": {
      "main": [
        [
          {
            "node": "Write to Sheet",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Write to Sheet": {
      "main": [
        [
          {
            "node": "Loop Over Tables",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "callerPolicy": "workflowsFromSameOwner",
    "availableInMCP": false
  },
