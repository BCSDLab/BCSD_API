{
  "id": "pg-sheets-sync",
  "name": "PG → Sheets Sync (5min)",
  "active": true,
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{"field": "minutes", "minutesInterval": 5}]
        }
      },
      "id": "schedule-trigger",
      "name": "Every 5 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [0, 0]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT table_name FROM information_schema.tables WHERE table_schema = 'public' AND table_type = 'BASE TABLE' ORDER BY table_name",
        "options": {}
      },
      "id": "pg-list-tables",
      "name": "List PG Tables",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [220, 0]
    },
    {
      "parameters": {"options": {}},
      "id": "split-batches",
      "name": "Loop Over Tables",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [440, 0]
    },
    {
      "parameters": {
        "operation": "create",
        "documentId": {"__rl": true, "mode": "id", "value": "={{ $env.GOOGLE_SHEETS_ID }}"},
        "title": "={{ $json.table_name }}"
      },
      "id": "sheets-create",
      "name": "Ensure Sheet Exists",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [660, 0],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "=SELECT * FROM {{ $('Loop Over Tables').item.json.table_name }}",
        "options": {}
      },
      "id": "pg-dump-table",
      "name": "Dump Table",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [880, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict"},
          "conditions": [
            {
              "id": "has-rows",
              "leftValue": "={{ $input.all().length }}",
              "rightValue": 0,
              "operator": {"type": "number", "operation": "gt"}
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-has-data",
      "name": "Has Data?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [1100, 0]
    },
    {
      "parameters": {
        "operation": "clear",
        "documentId": {"__rl": true, "mode": "id", "value": "={{ $env.GOOGLE_SHEETS_ID }}"},
        "sheetName": {"__rl": true, "mode": "name", "value": "={{ $('Loop Over Tables').item.json.table_name }}"}
      },
      "id": "sheets-clear",
      "name": "Clear Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [1320, -100]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {"__rl": true, "mode": "id", "value": "={{ $env.GOOGLE_SHEETS_ID }}"},
        "sheetName": {"__rl": true, "mode": "name", "value": "={{ $('Loop Over Tables').item.json.table_name }}"},
        "columns": {
          "mappingMode": "autoMapInputData",
          "value": {}
        },
        "options": {}
      },
      "id": "sheets-append",
      "name": "Write to Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [1540, -100]
    }
  ],
  "connections": {
    "Every 5 Minutes": {"main": [[{"node": "List PG Tables", "type": "main", "index": 0}]]},
    "List PG Tables": {"main": [[{"node": "Loop Over Tables", "type": "main", "index": 0}]]},
    "Loop Over Tables": {"main": [[], [{"node": "Ensure Sheet Exists", "type": "main", "index": 0}]]},
    "Ensure Sheet Exists": {"main": [[{"node": "Dump Table", "type": "main", "index": 0}]]},
    "Dump Table": {"main": [[{"node": "Has Data?", "type": "main", "index": 0}]]},
    "Has Data?": {"main": [[{"node": "Clear Sheet", "type": "main", "index": 0}], [{"node": "Loop Over Tables", "type": "main", "index": 0}]]},
    "Clear Sheet": {"main": [[{"node": "Write to Sheet", "type": "main", "index": 0}]]},
    "Write to Sheet": {"main": [[{"node": "Loop Over Tables", "type": "main", "index": 0}]]}
  },
  "settings": {"executionOrder": "v1"}
}
