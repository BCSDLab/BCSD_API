{
  "id": "link-auto-expire",
  "name": "Link Auto-Expiration (1min)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{"field": "minutes", "minutesInterval": 1}]
        }
      },
      "id": "schedule-trigger",
      "name": "Every Minute",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [0, 0]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE links SET expired_at = NOW()::text, updated_at = NOW()::text WHERE expires_at < NOW()::text AND expires_at != '' AND expired_at = '' RETURNING id",
        "options": {}
      },
      "id": "pg-expire",
      "name": "Expire Links",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [220, 0],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "conditions": {
          "options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict"},
          "conditions": [
            {
              "id": "check-expired",
              "leftValue": "={{ $input.all().length }}",
              "rightValue": 0,
              "operator": {"type": "number", "operation": "gt"}
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-expired",
      "name": "Any Expired?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [440, 0]
    },
    {
      "parameters": {
        "jsCode": "const count = $input.all().length;\nreturn [{ json: { text: `Link Auto-Expiration: ${count} link(s) expired` } }];"
      },
      "id": "format-message",
      "name": "Format Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, -100]
    }
  ],
  "connections": {
    "Every Minute": {"main": [[{"node": "Expire Links", "type": "main", "index": 0}]]},
    "Expire Links": {"main": [[{"node": "Any Expired?", "type": "main", "index": 0}]]},
    "Any Expired?": {"main": [[{"node": "Format Message", "type": "main", "index": 0}], []]}
  },
  "settings": {"executionOrder": "v1"}
}
